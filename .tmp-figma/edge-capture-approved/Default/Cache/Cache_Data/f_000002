body {
  --lightningcss-light: initial;
  --lightningcss-dark: ;
  color-scheme: light;
  background: var(--color-slate-100);
  color: var(--color-slate-900);
  font-family: var(--font-sans);
}

.price-service-shell {
  --service-nav-height: 0px;
  background: #f8faf8;
  min-height: 100dvh;
}

.floating-header {
  z-index: 50;
  justify-content: flex-start;
  align-items: center;
  height: 72px;
  padding: 14px 24px;
  display: flex;
  position: relative;
}

.mobile-brand {
  color: var(--color-primary);
  font-size: 22px;
  font-weight: 750;
  display: none;
}

.floating-menu-root {
  position: relative;
}

.menu-trigger {
  width: 44px;
  height: 44px;
  color: var(--color-primary);
  cursor: pointer;
  background: #ffffffeb;
  border: 1px solid #e1e9e2;
  border-radius: 13px;
  place-items: center;
  display: grid;
}

.menu-trigger:hover {
  background: #edf5ef;
}

.floating-menu-bridge {
  width: 220px;
  padding-top: 8px;
  position: absolute;
  top: 100%;
  left: 0;
}

.floating-menu-panel {
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  background: #fffffff2;
  border: 1px solid #fff;
  border-radius: 20px;
  padding: 16px;
  box-shadow: 0 16px 50px #183e2524;
}

.price-home {
  gap: 32px;
  min-width: 0;
  padding: 14px 32px 32px;
  display: grid;
}

.price-home h2 {
  letter-spacing: -.6px;
  font-size: 23px;
  font-weight: 750;
  line-height: 1.4;
}

.home-hero-grid {
  grid-template-columns: minmax(0, 2.45fr) minmax(0, 1fr);
  gap: 24px;
  display: grid;
}

.home-hero {
  background: linear-gradient(115deg, #edf6ed, #f4f8ef);
  border: 1px solid #e6eee4;
  border-radius: 28px;
  flex-direction: column;
  justify-content: space-between;
  padding: 36px;
  display: flex;
  position: relative;
  overflow: hidden;
}

.hero-copy {
  z-index: 1;
  max-width: 76%;
  position: relative;
}

.home-eyebrow {
  color: #5b7b60;
  letter-spacing: 1.1px;
  font-size: 12px;
  font-weight: 650;
}

.home-hero h1 {
  letter-spacing: -1.6px;
  word-break: keep-all;
  margin-top: 13px;
  font-size: clamp(28px, 2.7vw, 44px);
  font-weight: 800;
  line-height: 1.3;
}

.home-hero h1 span {
  color: var(--color-primary);
}

.hero-description {
  color: #657566;
  word-break: keep-all;
  margin-top: 16px;
  font-size: 14px;
  line-height: 1.7;
}

.hero-produce {
  width: 26%;
  height: 210px;
  position: absolute;
  top: 20px;
  right: 16px;
}

.produce-orbit {
  background: #dfecd9;
  border-radius: 50%;
  width: 180px;
  height: 180px;
  position: absolute;
  top: 8px;
  right: 0;
}

.hero-green-onion {
  object-fit: contain;
  mix-blend-mode: multiply;
  width: 85%;
  height: 155px;
  position: absolute;
  top: 4px;
  right: 8px;
  transform: rotate(-15deg);
}

.hero-onion {
  object-fit: contain;
  mix-blend-mode: multiply;
  width: 50%;
  height: 92px;
  position: absolute;
  bottom: 13px;
  left: 0;
  transform: rotate(12deg);
}

.produce-note {
  color: #617451;
  font-size: 11px;
  line-height: 1.7;
  position: absolute;
  bottom: 0;
  right: 0;
}

.home-search-area {
  z-index: 1;
  margin-top: 30px;
  position: relative;
}

.home-search {
  background: #fff;
  border: 1px solid #dae6d9;
  border-radius: 14px;
  align-items: center;
  gap: 12px;
  padding: 6px 6px 6px 16px;
  display: flex;
  box-shadow: 0 4px 10px #294a3010;
}

.home-search input {
  outline: none;
  flex: 1;
  width: 0;
  min-width: 0;
  height: 44px;
  font-size: 13px;
}

.home-search:focus-within {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}

.home-search button {
  background: var(--color-primary);
  color: #fff;
  cursor: pointer;
  border-radius: 10px;
  min-height: 44px;
  padding: 0 22px;
  font-size: 14px;
  font-weight: 650;
}

.home-ai-card {
  background: #e8f2e8;
  border: 1px solid #dce9dc;
  border-radius: 28px;
  padding: 28px;
}

.ai-badge {
  color: var(--color-primary);
  background: #ffffffb3;
  border-radius: 20px;
  padding: 6px 11px;
  font-size: 12px;
  font-weight: 650;
  display: inline-flex;
}

.home-ai-card h2 {
  color: var(--color-primary);
  margin-top: 17px;
}

.home-ai-card p {
  color: #627768;
  margin-top: 10px;
  font-size: 13px;
  line-height: 1.7;
}

.ai-preview-chart {
  width: 100%;
  max-height: 82px;
  margin-top: 14px;
}

.popular-ingredients {
  align-items: center;
  gap: 20px;
  min-width: 0;
  margin-top: -10px;
  display: flex;
}

.popular-ingredients > p {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 650;
}

.popular-chips {
  gap: 8px;
  min-width: 0;
  padding: 3px;
  display: flex;
  overflow-x: auto;
}

.popular-chips button {
  white-space: nowrap;
  color: #536356;
  cursor: pointer;
  background: #fff;
  border: 1px solid #e3e9e2;
  border-radius: 24px;
  min-height: 44px;
  padding: 0 18px;
  font-size: 13px;
}

.popular-chips button:hover {
  color: var(--color-primary);
  border-color: #8cad91;
}

.home-section-heading {
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  display: flex;
}

.home-section-heading p {
  color: var(--color-muted);
  word-break: keep-all;
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.7;
}

.home-more {
  color: #617168;
  flex-shrink: 0;
  align-items: center;
  gap: 12px;
  min-height: 44px;
  font-size: 13px;
  display: flex;
}

.featured-price-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  display: grid;
}

.featured-price-card {
  background: #fff;
  border: 1px solid #e4eae4;
  border-radius: 22px;
  min-width: 0;
  padding: 24px;
  box-shadow: 0 5px 16px #233b2805;
}

.ingredient-image {
  background: #f4f7ef;
  border-radius: 18px;
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  padding: 5px;
}

.ingredient-placeholder {
  color: #8c9b84;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 6px;
  height: 100%;
  font-size: 11px;
  display: flex;
}

.ingredient-category {
  color: #5f7a57;
  background: #f0f5ed;
  border-radius: 5px;
  padding: 3px 7px;
  font-size: 10px;
}

.featured-price-card h3 {
  margin: 4px 0 2px;
  font-size: 21px;
  font-weight: 750;
}

.featured-price-values {
  border-top: 1px solid #f0f3ed;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin: 22px 0 15px;
  padding-top: 20px;
  display: flex;
}

.featured-price-values p {
  color: var(--color-muted);
  margin-bottom: 5px;
  font-size: 12px;
}

.featured-price-values strong {
  letter-spacing: -.8px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  font-size: clamp(21px, 2vw, 29px);
  font-weight: 750;
}

.price-direction {
  border-radius: 7px;
  padding: 6px 10px;
  font-size: 12px;
  font-weight: 600;
  display: inline-flex;
}

.price-up {
  color: #c24149;
  background: #fff0f0;
}

.price-down {
  color: #2563b0;
  background: #edf4ff;
}

.home-analysis-grid {
  grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr);
  gap: 24px;
  display: grid;
}

.home-trend-panel, .home-factor-panel {
  background: #fff;
  border: 1px solid #e4eae4;
  border-radius: 24px;
  min-width: 0;
  padding: 28px;
}

.home-ingredient-selector {
  gap: 8px;
  margin-bottom: 18px;
  display: flex;
}

.home-ingredient-selector button {
  cursor: pointer;
  border: 1px solid #e4eae4;
  border-radius: 10px;
  min-height: 44px;
  padding: 0 19px;
  font-size: 13px;
}

.home-ingredient-selector button[aria-pressed="true"] {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.home-factor-panel h2 {
  margin-top: 8px;
  font-size: 22px;
}

.home-factor-card {
  background: #f7f9f6;
  border-radius: 14px;
  align-items: flex-start;
  gap: 12px;
  padding: 14px;
  display: flex;
}

.factor-number {
  color: #759477;
  padding-top: 3px;
  font-size: 11px;
}

.home-factor-card h3 {
  font-size: 13px;
  font-weight: 700;
}

.home-factor-card p {
  color: #708073;
  word-break: keep-all;
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.7;
}

.home-mobile-cta {
  display: none;
}

.home-sample-note {
  text-align: center;
  color: #78877c;
  font-size: 11px;
  line-height: 1.8;
}

.price-home button:focus-visible, .floating-header :focus-visible, .price-home a:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}

@media (max-width: 1023px) {
  .floating-header {
    justify-content: space-between;
    padding-inline: 24px;
  }

  .mobile-brand {
    align-items: center;
    min-height: 44px;
    display: flex;
  }

  .floating-menu-bridge {
    left: auto;
    right: 0;
  }

  .price-home {
    gap: 28px;
    padding: 8px 24px 28px;
  }

  .home-hero-grid {
    grid-template-columns: 1fr;
  }

  .home-ai-card {
    display: none;
  }

  .home-hero {
    min-height: 320px;
  }

  .home-hero h1 {
    font-size: 38px;
  }

  .featured-price-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .home-analysis-grid {
    grid-template-columns: 1fr;
  }

  .home-factor-panel > .grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  .floating-header {
    height: 68px;
    padding: 12px 20px;
  }

  .price-home {
    gap: 26px;
    padding: 8px 16px 24px;
  }

  .home-hero {
    border-radius: 22px;
    min-height: auto;
    padding: 26px 20px 20px;
  }

  .hero-copy {
    max-width: 100%;
  }

  .home-hero h1 {
    letter-spacing: -1.2px;
    font-size: clamp(25px, 7.3vw, 36px);
  }

  .home-eyebrow {
    font-size: 10px;
  }

  .hero-description {
    max-width: 245px;
    margin-top: 12px;
    font-size: 13px;
  }

  .hero-produce {
    display: none;
  }

  .home-search-area {
    margin-top: 22px;
  }

  .home-search {
    gap: 7px;
    padding-left: 10px;
  }

  .home-search input {
    font-size: 12px;
  }

  .home-search button {
    padding: 0 14px;
    font-size: 12px;
  }

  .popular-ingredients {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin-top: -4px;
  }

  .popular-ingredients > p {
    font-size: 12px;
  }

  .popular-chips {
    margin-right: -16px;
    padding-right: 16px;
  }

  .popular-chips button {
    padding-inline: 16px;
    font-size: 12px;
  }

  .price-home h2 {
    font-size: 20px;
  }

  .home-section-heading {
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 16px;
  }

  .home-section-heading p {
    font-size: 12px;
  }

  .home-more {
    gap: 4px;
    font-size: 11px;
  }

  .featured-price-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .featured-price-card {
    padding: 20px;
  }

  .ingredient-image {
    width: 64px;
    height: 64px;
  }

  .featured-price-values {
    margin-top: 16px;
    padding-top: 16px;
  }

  .featured-price-values strong {
    font-size: 27px;
  }

  .home-trend-panel, .home-factor-panel {
    border-radius: 20px;
    padding: 20px 14px;
  }

  .home-factor-panel > .grid {
    grid-template-columns: 1fr;
  }

  .home-mobile-cta {
    color: #fff;
    background: var(--color-primary);
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    gap: 16px;
    min-height: 50px;
    font-size: 14px;
    font-weight: 600;
    display: flex;
  }
}

.price-page {
  min-width: 0;
  padding: 16px 32px 48px;
}

.price-page h1 {
  letter-spacing: -1px;
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 800;
  line-height: 1.3;
}

.price-page h2 {
  letter-spacing: -.5px;
  font-size: 23px;
  font-weight: 750;
  line-height: 1.45;
}

.price-page-heading {
  margin-bottom: 30px;
}

.price-page-heading h1 {
  margin-top: 10px;
}

.price-page-heading > p:last-child {
  color: #65756b;
  margin-top: 12px;
  font-size: 15px;
  line-height: 1.8;
}

.price-list-tools {
  background: #edf5ed;
  border: 1px solid #e0e9de;
  border-radius: 22px;
  padding: 24px;
}

.price-list-search {
  background: #fff;
  border: 1px solid #dce5d9;
  border-radius: 13px;
  align-items: center;
  gap: 12px;
  max-width: 760px;
  min-height: 56px;
  padding: 0 18px;
  display: flex;
}

.price-list-search:focus-within {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.price-list-search input {
  background: none;
  outline: none;
  width: 100%;
  min-width: 0;
  min-height: 52px;
  font-size: 14px;
}

.price-category-chips {
  gap: 8px;
  margin-top: 16px;
  padding: 3px;
  display: flex;
  overflow-x: auto;
}

.price-category-chips button {
  white-space: nowrap;
  cursor: pointer;
  background: #fff;
  border: 1px solid #dce5d9;
  border-radius: 24px;
  min-height: 44px;
  padding: 0 22px;
  font-size: 13px;
}

.price-category-chips button[aria-pressed="true"] {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.price-data-note {
  color: #637369;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin: 24px 0;
  font-size: 13px;
  line-height: 1.7;
  display: flex;
}

.data-badge {
  white-space: nowrap;
  border-radius: 6px;
  align-items: center;
  padding: 5px 9px;
  font-size: 11px;
  font-weight: 650;
  display: inline-flex;
}

.data-poc {
  color: #14532d;
  background: #e7f3e8;
}

.data-demo {
  color: #78623d;
  background: #f8f2e7;
}

.price-catalog-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  display: grid;
}

.price-card-link {
  border-radius: inherit;
  display: block;
}

.featured-price-card:has(.price-card-link) {
  padding: 0;
}

.price-card-link {
  padding: 24px;
}

.poc-featured {
  border-color: #bdd6bc;
  box-shadow: 0 4px 18px #23462c09;
}

.price-card-link:hover {
  background: #f8fbf6;
}

.price-card-link:focus-visible, .price-page button:focus-visible, .price-back-link:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}

.price-empty {
  text-align: center;
  color: #65756b;
  border: 1px dashed #d3dfd1;
  border-radius: 16px;
  padding: 40px 20px;
}

.price-empty p {
  margin-top: 10px;
  font-size: 14px;
}

.price-empty button {
  color: #fff;
  background: var(--color-primary);
  border-radius: 10px;
  min-height: 44px;
  margin-top: 20px;
  padding: 0 20px;
}

.hero-poc-values {
  color: var(--color-primary);
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10px;
  margin: 16px 0 10px;
  font-size: 18px;
  display: flex;
}

.hero-poc-values strong {
  font-size: 26px;
  font-weight: 750;
}

.price-back-link {
  color: #637569;
  align-items: center;
  min-height: 44px;
  margin-bottom: 18px;
  font-size: 14px;
  display: inline-flex;
}

.price-detail-page {
  gap: 24px;
  display: grid;
}

.price-detail-page > .price-back-link {
  justify-self: start;
  margin-bottom: 0;
}

.price-detail-overview {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
  align-items: stretch;
  gap: 24px;
  display: grid;
}

.price-panel {
  background: #fff;
  border: 1px solid #e1e9df;
  border-radius: 24px;
  min-width: 0;
  padding: 28px;
  box-shadow: 0 4px 16px #233b2804;
}

.product-overview {
  flex-direction: column;
  display: flex;
}

.product-overview .ingredient-image {
  width: 100px;
  height: 100px;
}

.product-overview .featured-price-values {
  margin-top: 28px;
}

.price-dates {
  gap: 10px;
  margin-top: auto;
  padding-top: 24px;
  font-size: 13px;
  display: grid;
}

.price-dates > div {
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10px;
  display: flex;
}

.price-dates dt {
  color: #748177;
}

.price-dates dd {
  font-variant-numeric: tabular-nums;
  font-weight: 550;
}

.price-chart-section {
  min-width: 0;
}

.price-chart-heading {
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  display: flex;
}

.chart-periods {
  background: #eef3ed;
  border-radius: 10px;
  flex-shrink: 0;
  gap: 3px;
  padding: 3px;
  display: flex;
}

.chart-periods button {
  color: #697d6e;
  cursor: pointer;
  border-radius: 8px;
  min-width: 44px;
  min-height: 44px;
  padding: 0 12px;
  font-size: 12px;
}

.chart-periods button[aria-pressed="true"] {
  color: var(--color-primary);
  background: #fff;
  font-weight: 700;
  box-shadow: 0 2px 6px #183e2510;
}

.chart-demo-notice {
  color: #786944;
  word-break: keep-all;
  background: #faf7ef;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12px;
  line-height: 1.7;
}

.chart-legend {
  color: #66796c;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin: 18px 0 12px;
  font-size: 11px;
  display: flex;
}

.chart-legend > span {
  align-items: center;
  gap: 6px;
  display: flex;
}

.chart-legend i {
  border-top: 2px solid #83918b;
  width: 18px;
}

.chart-legend .legend-dashed {
  border-top: 2px dashed #14532d;
}

.price-trend-svg {
  width: 100%;
  display: block;
  overflow: visible;
}

.chart-footnote {
  color: #718075;
  margin-top: 8px;
  font-size: 11px;
  line-height: 1.8;
}

.price-buying-guide {
  background: #eaf3e8;
  border: 1px solid #dce8d9;
  border-radius: 24px;
  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  align-items: center;
  gap: 40px;
  padding: 28px 32px;
  display: grid;
}

.price-buying-guide h2 {
  color: var(--color-primary);
  margin-top: 10px;
}

.price-buying-guide > div > p:last-child {
  color: #617362;
  word-break: keep-all;
  max-width: 620px;
  margin-top: 10px;
  font-size: 14px;
  line-height: 1.8;
}

.guide-values {
  text-align: right;
}

.guide-values .featured-price-values {
  text-align: left;
  border-top: 0;
  margin-top: 0;
  padding-top: 0;
}

.factor-summary-panel h2, .home-factor-panel h2 {
  margin-top: 8px;
}

.factor-summary-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 22px;
  display: grid;
}

.home-factor-panel .factor-summary-grid {
  grid-template-columns: 1fr;
}

.factor-category-card {
  background: #f6f9f4;
  border: 1px solid #e7ede3;
  border-radius: 16px;
  padding: 20px;
}

.factor-category-card h3 {
  font-size: 16px;
  font-weight: 700;
}

.factor-category-card p {
  color: #627464;
  word-break: keep-all;
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.85;
}

.factor-caveat {
  color: #748177;
  margin-top: 18px;
  font-size: 12px;
  line-height: 1.8;
}

.factor-bar-legend {
  color: #6e7a71;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding-bottom: 14px;
  font-size: 12px;
  display: flex;
}

.factor-accordion-row {
  border-top: 1px solid #e7ede5;
}

.factor-toggle {
  text-align: left;
  cursor: pointer;
  border-radius: 8px;
  grid-template-columns: minmax(180px, 1fr) minmax(160px, 1.2fr) 100px 28px;
  align-items: center;
  gap: 24px;
  width: 100%;
  padding: 20px 0;
  display: grid;
}

.factor-label, .shap-number {
  flex-direction: column;
  gap: 7px;
  display: flex;
}

.factor-label strong {
  font-size: 14px;
  font-weight: 650;
}

.factor-label > span {
  color: #6e7a71;
  font-size: 13px;
  font-weight: 400;
}

.shap-number {
  text-align: right;
}

.shap-number strong {
  font-size: 15px;
  font-weight: 650;
}

.shap-number > span {
  font-size: 11px;
  font-weight: 400;
}

.shap-bar {
  background: linear-gradient(90deg, #f1f6fd 50%, #fdf3f3 50%);
  border-radius: 6px;
  height: 28px;
  display: block;
  position: relative;
}

.shap-bar > i:not(.shap-zero) {
  border-radius: 3px;
  height: 14px;
  position: absolute;
  top: 7px;
}

.shap-zero {
  z-index: 1;
  border-left: 1px solid #bbc9be;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
}

.shap-down {
  background: #568acd;
}

.shap-up {
  background: #dc777d;
}

.factor-chevron {
  text-align: center;
  color: #6b7d70;
  font-size: 20px;
  font-weight: 400;
}

.factor-expanded {
  color: #5b6f60;
  padding: 0 20px 22px;
  font-size: 13px;
  line-height: 1.85;
}

.factor-expanded > p {
  margin-top: 8px;
}

.factor-history-placeholder {
  background: #f7f9f5;
  border: 1px dashed #cddacb;
  border-radius: 12px;
  margin-top: 16px;
  padding: 20px;
  font-size: 14px;
}

.factor-history-placeholder span {
  color: #7b877d;
  margin-top: 5px;
  font-size: 12px;
  display: block;
}

@media (max-width: 1023px) {
  .price-page {
    padding: 12px 24px 36px;
  }

  .price-catalog-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .price-detail-overview {
    grid-template-columns: 1fr;
  }

  .product-overview .featured-price-values strong {
    font-size: 34px;
  }

  .factor-toggle {
    grid-template-columns: minmax(160px, 1fr) minmax(110px, 1fr) 85px 24px;
    gap: 16px;
  }
}

@media (max-width: 767px) {
  .price-page {
    padding: 8px 16px 28px;
  }

  .price-page h2 {
    font-size: 20px;
  }

  .price-page-heading {
    margin-bottom: 22px;
  }

  .price-page-heading > p:last-child {
    font-size: 14px;
  }

  .price-list-tools {
    border-radius: 18px;
    padding: 16px 12px;
  }

  .price-list-search {
    padding-inline: 12px;
  }

  .price-list-search input {
    font-size: 12px;
  }

  .price-category-chips button {
    padding-inline: 16px;
  }

  .price-catalog-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .price-data-note {
    gap: 8px;
    margin: 18px 0;
    font-size: 12px;
  }

  .price-card-link {
    padding: 20px;
  }

  .price-detail-page, .price-detail-overview {
    gap: 18px;
  }

  .price-panel {
    border-radius: 20px;
    padding: 22px 18px;
  }

  .detail-chart-panel {
    padding-inline: 12px;
  }

  .product-overview .ingredient-image {
    width: 80px;
    height: 80px;
  }

  .product-overview .featured-price-values strong {
    font-size: 28px;
  }

  .price-buying-guide {
    border-radius: 20px;
    grid-template-columns: 1fr;
    gap: 22px;
    padding: 22px 20px;
  }

  .factor-summary-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .factor-category-card {
    padding: 16px;
  }

  .factor-toggle {
    grid-template-columns: minmax(0, 1fr) 90px 22px;
    gap: 12px;
    padding: 16px 0;
  }

  .factor-label {
    grid-area: 1 / 1;
  }

  .shap-number {
    grid-area: 1 / 2;
  }

  .factor-chevron {
    grid-area: 1 / 3;
  }

  .shap-bar {
    grid-area: 2 / 1 / auto / -1;
  }

  .factor-expanded {
    padding: 0 0 18px;
  }

  .factor-history-placeholder {
    padding: 16px;
  }

  .home-ingredient-selector {
    flex-wrap: wrap;
  }
}

.chart-source-notice {
  color: #4b7050;
  background: #f0f7ef;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12px;
  line-height: 1.7;
}

.chart-legend .legend-actual {
  border-color: #23804d;
}

.chart-endpoints {
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 0 4px;
  display: flex;
}

.chart-endpoints > div:last-child {
  text-align: right;
}

.chart-endpoints dt {
  color: #708073;
  font-size: 11px;
}

.chart-endpoints dd {
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
  margin-top: 5px;
  font-size: 20px;
  font-weight: 700;
}

.detail-page-heading nav {
  color: #708073;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  display: flex;
}

.detail-page-heading .price-back-link {
  margin: 0;
}

.price-detail-overview {
  grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
}

.price-detail-overview .price-buying-guide {
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 28px;
  display: flex;
}

.prediction-summary > p {
  color: #607368;
  word-break: keep-all;
  margin-top: 10px;
  font-size: 15px;
  line-height: 1.9;
}

.detail-factor-layout {
  grid-template-columns: minmax(0, 2.5fr) minmax(0, 1fr);
  align-items: start;
  gap: 24px;
  display: grid;
}

.price-insights ol {
  counter-reset: insights;
  margin-top: 20px;
}

.price-insights li {
  color: #657869;
  word-break: keep-all;
  border-top: 1px solid #e5ede2;
  padding: 18px 0;
  font-size: 13px;
  line-height: 1.9;
}

.price-insights li:before {
  counter-increment: insights;
  content: "0" counter(insights);
  color: #80a081;
  margin-bottom: 5px;
  font-size: 12px;
  font-weight: 700;
  display: block;
}

.factor-history-chart {
  background: #f7faf5;
  border: 1px solid #e4ece1;
  border-radius: 14px;
  margin-top: 18px;
  padding: 18px;
}

.factor-history-heading {
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  display: flex;
}

.factor-history-heading h4 {
  font-size: 13px;
  font-weight: 650;
}

.factor-history-svg {
  width: 100%;
  max-height: 270px;
  margin-top: 15px;
  display: block;
}

@media (max-width: 1023px) {
  .price-detail-overview, .detail-factor-layout {
    grid-template-columns: 1fr;
  }

  .price-detail-overview .price-buying-guide {
    gap: 18px;
  }
}

@media (max-width: 767px) {
  .factor-history-chart {
    padding: 12px 8px;
  }

  .factor-history-heading {
    padding-inline: 4px;
  }

  .chart-endpoints dd {
    font-size: 18px;
  }

  .prediction-summary > p {
    font-size: 14px;
  }

  .detail-factor-layout {
    gap: 18px;
  }
}

